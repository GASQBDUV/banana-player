# Run as `cmake -DROOT=<repo> -DOUT=<file.cpp> -P cmake/EmbedWeb.cmake` by the build (see CMakeLists.txt): writes the
# web dashboard's files into a C++ source, so the player serves its app from the binary, on any SD card.
# The served paths are relative to web/, plus fonts/ (the two fonts and their licences from assets/fonts).

set(WEB_DIR "${ROOT}/web")
set(FONT_DIR "${ROOT}/assets/fonts")

set(PATHS "")
set(FILES "")

file(GLOB_RECURSE web_files RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")
foreach(rel IN LISTS web_files)
	# a dotfile (.DS_Store, the ._ files a Mac leaves on a card) is not part of the app
	get_filename_component(name "${rel}" NAME)
	if(IS_DIRECTORY "${WEB_DIR}/${rel}" OR name MATCHES "^\\.")
		continue()
	endif()
	list(APPEND PATHS "${rel}")
	list(APPEND FILES "${WEB_DIR}/${rel}")
endforeach()

# the fonts are served from fonts/ under their own names; the licences under the names the web page links
list(APPEND PATHS "fonts/PixelifySans-Regular.ttf" "fonts/Inter-Regular.ttf" "fonts/Inter-Bold.ttf" "fonts/OFL-Pixelify.txt" "fonts/OFL-Inter.txt")
list(APPEND FILES
	"${FONT_DIR}/PixelifySans-Regular.ttf"
	"${FONT_DIR}/Inter-Regular.ttf"
	"${FONT_DIR}/Inter-Bold.ttf"
	"${FONT_DIR}/licenses/PixelifySans-OFL.txt"
	"${FONT_DIR}/licenses/Inter-LICENSE.txt")

# the served type, by extension (the browser needs the right one for fonts and for the module scripts)
function(bp_mime path out)
	get_filename_component(ext "${path}" LAST_EXT)
	string(TOLOWER "${ext}" ext)
	if(ext STREQUAL ".html")
		set(mime "text/html; charset=utf-8")
	elseif(ext STREQUAL ".js")
		set(mime "text/javascript; charset=utf-8")
	elseif(ext STREQUAL ".css")
		set(mime "text/css; charset=utf-8")
	elseif(ext STREQUAL ".svg")
		set(mime "image/svg+xml")
	elseif(ext STREQUAL ".ttf")
		set(mime "font/ttf")
	elseif(ext STREQUAL ".woff2")
		set(mime "font/woff2")
	elseif(ext STREQUAL ".txt")
		set(mime "text/plain; charset=utf-8")
	elseif(ext STREQUAL ".png")
		set(mime "image/png")
	elseif(ext STREQUAL ".json")
		set(mime "application/json")
	elseif(ext STREQUAL ".wasm")
		set(mime "application/wasm")
	else()
		set(mime "application/octet-stream")
	endif()
	set(${out} "${mime}" PARENT_SCOPE)
endfunction()

set(code "// Generated by cmake/EmbedWeb.cmake from web/ and assets/fonts/: do not edit.\n")
string(APPEND code "#include \"web/assets.h\"\n\nnamespace bp {\nnamespace {\n")
set(entries "")
set(index 0)
list(LENGTH PATHS count)
while(index LESS count)
	list(GET PATHS ${index} path)
	list(GET FILES ${index} src)

	# the bytes as C array elements, 16 to a line; an empty file gets one 0 so the array is valid
	file(READ "${src}" hex HEX)
	string(LENGTH "${hex}" hexlen)
	if(hexlen EQUAL 0)
		set(bytes "0x00")
	else()
		string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
		string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n" bytes "${bytes}")
	endif()
	math(EXPR len "${hexlen} / 2")
	# the etag is a content hash; the server quotes it
	file(SHA1 "${src}" sha)
	string(SUBSTRING "${sha}" 0 16 etag)

	bp_mime("${path}" mime)
	string(APPEND code "const unsigned char d${index}[] = {\n${bytes}\n};\n")
	string(APPEND entries "\t{\"${path}\", \"${mime}\", d${index}, ${len}, \"${etag}\"},\n")
	math(EXPR index "${index} + 1")
endwhile()

string(APPEND code "}  // namespace\n\nconst WebAsset WEB_ASSETS[] = {\n${entries}};\nconst size_t WEB_ASSET_COUNT = sizeof WEB_ASSETS / sizeof WEB_ASSETS[0];\n\n}  // namespace bp\n")
file(WRITE "${OUT}" "${code}")
